# ==============================================================================
# RFP Intelligence Platform — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------------------
# 1. Groq Configuration (LLM & Vision OCR Fallback)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_OCR_MODEL=llama-3.2-11b-vision-preview

# ------------------------------------------------------------------------------
# 2. Jina AI Configuration (Embeddings & Listwise Reranking)
# ------------------------------------------------------------------------------
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANKER_MODEL=jina-reranker-v3.5

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database Configuration
# ------------------------------------------------------------------------------
# Set QDRANT_URL to use remote instance, or leave empty to use local embedded storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=outputs/qdrant_storage
QDRANT_COLLECTION=rfp_chunks

# ------------------------------------------------------------------------------
# 4. Retrieval & Multi-Agent Tuning Defaults
# ------------------------------------------------------------------------------
DENSE_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5
MAX_RETRIES=2
MAX_QA_RETRIES=2

# ------------------------------------------------------------------------------
# 5. Observability (LangSmith & OpenTelemetry - Optional)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rfp-intelligence-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
